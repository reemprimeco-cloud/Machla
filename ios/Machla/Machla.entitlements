<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The one capability this app needs, and the only one requested.

	  "development" is correct even for an App Store build: Xcode rewrites
	  this value to "production" when it archives for distribution. Setting
	  it to production by hand is the classic way to end up with a
	  TestFlight build whose notifications never arrive, because the token
	  it registers is then only valid against the other APNs host
	  (see APNS_ENVIRONMENT in lib/push/apns.ts).

	  Associated Domains (universal links) is deliberately NOT here. It
	  would need the capability enabled on the App ID and an
	  apple-app-site-association file carrying the real Team ID, and an
	  entitlement the provisioning profile does not grant fails the build
	  outright — a bad trade for a convenience the app does not yet use.
	  ios/README.md has the steps if it is ever wanted.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
